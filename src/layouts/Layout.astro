---
import '../styles/global.css';
import BlobCursor from '../components/BlobCursor';
import IntroAnimation from '../components/IntroAnimation.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Pratyush Gupta — Full Stack Web Developer & CS Engineer",
  description = "Personal portfolio & resume of Pratyush Gupta, driven Computer Science Engineering student specializing in full-stack web development, Next.js, Astro, REST APIs, and AI-driven applications."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Google Fonts for Miranda Broadsheet system -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=IM+Fell+English:ital@0;1&family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Source+Serif+4:ital,opsz,wght@0,8..60,300..700;1,8..60,300..700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#e2dedb] text-[#1d1d1b] selection:bg-[#1d1d1b] selection:text-[#e2dedb] min-h-screen">
    <!-- Intro 3D Rotate -> Zoom Animation -->
    <IntroAnimation />

    <!-- React Bits BlobCursor with hydration client:load -->
    <BlobCursor client:load size={32} fastness={0.15} />

    <!-- Main Page Content -->
    <slot />

    <!-- IntersectionObserver for restrained, editorial reveal transitions -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const observerOptions = {
          root: null,
          rootMargin: '0px 0px -50px 0px',
          threshold: 0.1
        };

        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, observerOptions);

        document.querySelectorAll('.reveal-on-scroll').forEach(el => {
          observer.observe(el);
        });
      });
    </script>
  </body>
</html>

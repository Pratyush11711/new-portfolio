---
const projects = [
  {
    title: "Free LinkedIn Text Formatter",
    isNew: true,
    tag: "LIVE UTILITY",
    description: "Free web-based SEO tool built with Astro, Tailwind CSS, and Cloudflare Workers that converts plain text into Unicode-styled bold, italic, and script fonts with live LinkedIn preview.",
    tech: ["Astro", "Tailwind CSS", "Cloudflare Workers", "Unicode API"],
    link: "https://freelinkedintextformatter.com",
    domain: "freelinkedintextformatter.com",
    visual: "LINKEDIN / UNICODE ENGINE"
  },
  {
    title: "PeptidePrecise",
    isNew: true,
    tag: "PWA APPLICATION",
    description: "Specialized peptide dosing calculator featuring a 186-entry reference library, unit conversions, reconstitution math, and offline PWA support for research compliance.",
    tech: ["Astro", "Tailwind CSS", "Cloudflare Workers", "PWA"],
    link: "https://precisepeptidecalculator.com",
    domain: "precisepeptidecalculator.com",
    visual: "PEPTIDE / CALCULATOR ENGINE"
  },
  {
    title: "QR Code Generator",
    isNew: false,
    tag: "CUSTOM TOOL",
    description: "Full-featured vector QR code generator supporting custom color gradients, error-correction level selection, matrix shape customization, and drag-and-drop logo embedding.",
    tech: ["Next.js", "TypeScript", "Canvas API", "SVG Exports"],
    link: null,
    domain: "Internal Tool",
    visual: "VECTOR / QR MATRIX"
  },
  {
    title: "PDF Summarization App",
    isNew: false,
    tag: "AI & DATABASE",
    description: "Intelligent document parsing application that extracts unstructured text from multi-page PDFs, generates structured summaries via AI models, and persists insights in PostgreSQL.",
    tech: ["Python", "Express.js", "PostgreSQL", "AI Processing"],
    link: null,
    domain: "Full-Stack Project",
    visual: "PDF / POSTGRES STORAGE"
  },
  {
    title: "Real-Time Chat Application",
    isNew: false,
    tag: "FULL-STACK MERN",
    description: "Instant messaging portal built with React.js, WebSockets, and MongoDB featuring user authentication, room isolation, message history persistence, and online status tracking.",
    tech: ["React.js", "Node.js", "MongoDB", "WebSockets"],
    link: null,
    domain: "Real-time System",
    visual: "WEBSOCKET / MESSAGING"
  }
];
---

<section id="projects" class="py-16 border-b border-[#1d1d1b] reveal-on-scroll">
  <div class="max-w-[1440px] mx-auto px-4 md:px-8">
    
    <!-- Section Header Micro-Label -->
    <div class="flex items-center justify-between border-b border-[#1d1d1b] pb-2 mb-8">
      <span class="micro-label text-[#c03f13]">SECTION 04 // INDEX OF WORKS</span>
      <span class="micro-label text-[#69645f]">SELECTED PROJECTS</span>
    </div>

    <!-- Title Banner -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between mb-12 gap-4">
      <div>
        <h2 class="heading-canopee text-[38px] sm:text-[56px] md:text-[76px] text-[#1d1d1b] uppercase">
          FEATURED PROJECTS & UTILITIES
        </h2>
        <p class="font-editorial text-base md:text-lg text-[#69645f] font-light max-w-xl">
          Curated showcase of web applications, developer utilities, and backend architectures built for performance and search visibility.
        </p>
      </div>
      <div class="flex items-center gap-2 micro-label text-[#1d1d1b]">
        <span class="w-3 h-3 bg-[#c03f13] inline-block rounded-[2.88px]"></span>
        <span>EMBER BADGE INDICATES ACTIVE PRODUCTION RELEASE</span>
      </div>
    </div>

    <!-- 3-Column / 2-Column Broadsheet Project Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {projects.map((proj) => (
        <div class="bg-[#cdc6be] rounded-[11.52px] border border-[#1d1d1b] overflow-hidden flex flex-col justify-between shadow-[-4px_4px_6px_0px_rgba(29,29,27,0.2)] hover:border-[#000000] transition-all group">
          
          <div>
            <!-- Top Duotone Graphic Card Header (0px radius per Miranda spec) -->
            <div class="bg-[#1d1d1b] text-[#e2dedb] p-6 h-40 flex flex-col justify-between border-b border-[#1d1d1b] relative overflow-hidden group-hover:bg-[#000000] transition-colors">
              <div class="flex items-center justify-between text-[11px] font-editorial tracking-widest text-[#cdc6be]/80">
                <span>{proj.tag}</span>
                <span>001 / '26</span>
              </div>

              <div class="font-canopee text-2xl md:text-3xl text-[#e2dedb] tracking-wider uppercase">
                {proj.visual}
              </div>

              <!-- Decorative duotone broadsheet graphic pattern -->
              <div class="absolute -right-4 -bottom-6 text-6xl text-[#cdc6be]/10 font-canopee pointer-events-none select-none">
                ★
              </div>
            </div>

            <!-- Card Content Body -->
            <div class="p-6">
              <!-- Title + NEW Badge -->
              <div class="flex items-start gap-2.5 mb-3 flex-wrap">
                <h3 class="font-domaine text-xl md:text-2xl text-[#1d1d1b] font-medium leading-tight group-hover:text-[#c03f13] transition-colors">
                  {proj.title}
                </h3>
                {proj.isNew && (
                  <span class="bg-[#c03f13] text-[#e2dedb] text-[11px] font-editorial px-2 py-0.5 rounded-[2.88px] tracking-wider uppercase font-normal inline-block mt-0.5">
                    NEW
                  </span>
                )}
              </div>

              <!-- Description -->
              <p class="font-editorial text-base text-[#1d1d1b] font-light leading-[1.38] mb-4">
                {proj.description}
              </p>

              <!-- Tech Stack Badges -->
              <div class="flex flex-wrap gap-1.5 mb-6">
                {proj.tech.map((t) => (
                  <span class="text-[11px] font-editorial text-[#69645f] border border-[#1d1d1b]/30 px-2 py-0.5 rounded-[2.88px] bg-[#e2dedb]/50">
                    {t}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <!-- Card Footer & Link -->
          <div class="px-6 pb-6 pt-0 border-t border-[#1d1d1b]/20 mt-auto flex items-center justify-between font-editorial text-sm">
            <span class="text-[#69645f] text-xs">{proj.domain}</span>

            {proj.link ? (
              <a 
                href={proj.link} 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-[#1d1d1b] font-medium underline underline-offset-4 hover:text-[#c03f13] transition-colors"
              >
                <span>Visit Site</span>
                <span class="text-xs">↗</span>
              </a>
            ) : (
              <span class="text-[#69645f] italic text-xs">Repository / Private</span>
            )}
          </div>

        </div>
      ))}
    </div>

  </div>
</section>

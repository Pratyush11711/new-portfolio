---
---

<section id="education" class="py-16 border-b border-[#1d1d1b] reveal-on-scroll">
  <div class="max-w-[1440px] mx-auto px-4 md:px-8">
    
    <!-- Section Header Micro-Label -->
    <div class="flex items-center justify-between border-b border-[#1d1d1b] pb-2 mb-8">
      <span class="micro-label text-[#c03f13]">SECTION 05 // ACADEMIC RECORD</span>
      <span class="micro-label text-[#69645f]">EDUCATION & CREDENTIALS</span>
    </div>

    <!-- Title Banner -->
    <div class="mb-12">
      <h2 class="heading-canopee text-[38px] sm:text-[54px] md:text-[72px] text-[#1d1d1b] uppercase">
        ACADEMIC DEGREES & SCHOOLING
      </h2>
      <p class="font-editorial text-base md:text-lg text-[#69645f] font-light max-w-xl mt-1">
        Formal background in Computer Science Engineering, theoretical computer science, and foundation schooling.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      
      <!-- Major Degree Entry (Left Column - 7 cols) -->
      <div class="lg:col-span-7 bg-[#cdc6be] p-6 md:p-8 rounded-[11.52px] border border-[#1d1d1b] flex flex-col justify-between shadow-[-4px_4px_6px_0px_rgba(29,29,27,0.15)]">
        <div>
          <div class="flex items-center justify-between border-b border-[#1d1d1b] pb-3 mb-6">
            <span class="micro-label text-[#c03f13]">HIGHER EDUCATION · DEGREE PROGRAM</span>
            <span class="font-canopee text-xl text-[#1d1d1b]">EXPECTED 01/2027</span>
          </div>

          <h3 class="font-domaine text-2xl md:text-4xl text-[#1d1d1b] font-medium mb-2">
            VIT-AP University
          </h3>
          <p class="font-editorial text-lg text-[#69645f] font-light mb-4">
            Amaravati, Andhra Pradesh, India
          </p>

          <div class="p-4 bg-[#e2dedb] rounded-[7.2px] border border-[#1d1d1b] mb-6">
            <div class="font-editorial text-lg md:text-xl font-medium text-[#1d1d1b]">
              Bachelor of Technology (B.Tech)
            </div>
            <div class="font-editorial text-base text-[#69645f]">
              Computer Science and Engineering
            </div>
          </div>

          <ul class="space-y-2 font-editorial text-base text-[#1d1d1b] font-light">
            <li class="flex items-center gap-2">
              <span class="text-[#c03f13]">■</span>
              <span>Cumulative Grade Point Average (CGPA): <strong class="font-medium text-[#1d1d1b]">8.00 / 10.00</strong></span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-[#c03f13]">■</span>
              <span>Core Coursework: Data Structures, Algorithms, DBMS, Operating Systems, Computer Networks, AI</span>
            </li>
          </ul>
        </div>

        <div class="mt-8 pt-4 border-t border-[#1d1d1b]/20 flex justify-between items-center text-xs font-editorial text-[#69645f]">
          <span>VERIFIED ENROLLMENT</span>
          <span class="text-[#c03f13] font-medium">ACTIVE UNDERGRADUATE</span>
        </div>
      </div>

      <!-- Supporting Secondary School Entries (Right Column - 5 cols) -->
      <div class="lg:col-span-5 flex flex-col gap-6">
        
        <!-- Class 12th -->
        <div class="bg-[#e2dedb] p-6 rounded-[11.52px] border border-[#1d1d1b] flex-1 flex flex-col justify-between shadow-[-4px_4px_6px_0px_rgba(29,29,27,0.15)]">
          <div>
            <div class="flex items-center justify-between border-b border-[#cdc6be] pb-2 mb-3">
              <span class="micro-label text-[#1d1d1b]">SENIOR SECONDARY (CLASS XII)</span>
              <span class="font-canopee text-lg text-[#c03f13]">2022</span>
            </div>
            <h4 class="font-domaine text-xl text-[#1d1d1b] font-medium">
              Central Board of Secondary Education (CBSE)
            </h4>
            <p class="font-editorial text-sm text-[#69645f] mt-1">
              Senior Secondary Examination · Science Stream
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-[#1d1d1b] flex justify-between items-center">
            <span class="micro-label text-[11px] text-[#69645f]">FINAL SCORE</span>
            <span class="font-canopee text-2xl text-[#1d1d1b]">88.6%</span>
          </div>
        </div>

        <!-- Class 10th -->
        <div class="bg-[#e2dedb] p-6 rounded-[11.52px] border border-[#1d1d1b] flex-1 flex flex-col justify-between shadow-[-4px_4px_6px_0px_rgba(29,29,27,0.15)]">
          <div>
            <div class="flex items-center justify-between border-b border-[#cdc6be] pb-2 mb-3">
              <span class="micro-label text-[#1d1d1b]">SECONDARY SCHOOL (CLASS X)</span>
              <span class="font-canopee text-lg text-[#c03f13]">2020</span>
            </div>
            <h4 class="font-domaine text-xl text-[#1d1d1b] font-medium">
              Central Board of Secondary Education (CBSE)
            </h4>
            <p class="font-editorial text-sm text-[#69645f] mt-1">
              Secondary School Examination
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-[#1d1d1b] flex justify-between items-center">
            <span class="micro-label text-[11px] text-[#69645f]">FINAL SCORE</span>
            <span class="font-canopee text-2xl text-[#1d1d1b]">84.1%</span>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>

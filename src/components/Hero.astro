---

<section id="top" class="w-full pt-8 pb-16 border-b border-[#1d1d1b] overflow-hidden">
  <div class="max-w-[1440px] mx-auto px-4 md:px-8">
    
    <!-- Top Broadsheet Issue / Date Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center border-y border-[#1d1d1b] py-2 mb-8 text-[12px] font-editorial text-[#69645f] tracking-wide gap-2">
      <div class="flex items-center gap-3">
        <span class="font-medium text-[#1d1d1b] uppercase">VOL. 01 — NO. 26</span>
        <span>•</span>
        <span>SHAHJAHANPUR, UTTAR PRADESH, INDIA</span>
      </div>
      <div class="flex items-center gap-3">
        <span>B.TECH CSE '27</span>
        <span>•</span>
        <span class="text-[#c03f13] font-medium uppercase">AVAILABLE FOR INTERNSHIPS</span>
      </div>
    </div>

    <!-- Main Broadsheet Name Banner (Canopee / Bodoni Display) -->
    <div class="bg-[#1d1d1b] text-[#e2dedb] px-4 md:px-8 py-8 md:py-12 mb-8 overflow-hidden rounded-0">
      <h1 class="broadsheet-masthead-title text-[46px] sm:text-[80px] md:text-[130px] lg:text-[170px] text-center select-none text-[#e2dedb]">
        PRATYUSH GUPTA
      </h1>
      <div class="flex flex-col md:flex-row items-center justify-between border-t border-[#cdc6be]/30 pt-4 mt-6 gap-4 font-editorial">
        <p class="text-sm md:text-base tracking-wide uppercase text-[#cdc6be] text-center md:text-left">
          Full Stack Web Developer & Computer Science Engineer
        </p>
        <p class="text-xs text-[#cdc6be]/80 text-center md:text-right">
          INTELLIGENT SYSTEMS · SCALABLE WEB ARCHITECTURE · FULL-STACK ENGINEERING
        </p>
      </div>
    </div>

    <!-- Hero Content Grid: Two columns + Stamp Seal -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start pt-2">
      
      <!-- Left Column: Lead Story / One-line hook -->
      <div class="lg:col-span-7 flex flex-col gap-6">
        <div class="micro-label text-[#c03f13] flex items-center gap-2">
          <span>★</span>
          <span>SPECIAL EDITION — BIOGRAPHY & PORTFOLIO</span>
        </div>

        <h2 class="font-domaine text-3xl md:text-5xl leading-[0.98] text-[#1d1d1b] font-medium tracking-tight">
          Architecting robust digital experiences & AI applications with broadsheet precision.
        </h2>

        <p class="font-editorial text-lg md:text-xl text-[#1d1d1b] leading-[1.35] font-light max-w-2xl">
          Driven CS student specializing in Next.js, Astro, Python, and distributed web applications. Focused on engineering high-performance software, custom interactive tools, and automated content infrastructure.
        </p>

        <!-- CTAs & Quick Contacts -->
        <div class="flex flex-wrap items-center gap-4 pt-2 font-editorial">
          <a 
            href="#projects" 
            class="px-6 py-3 bg-[#1d1d1b] text-[#e2dedb] text-sm tracking-wide uppercase rounded-[2.88px] hover:bg-[#000000] transition-all flex items-center gap-2"
          >
            <span>Explore Projects</span>
            <span>↓</span>
          </a>
          <a 
            href="https://pratyush117portfolio.vercel.app" 
            target="_blank" 
            rel="noopener noreferrer"
            class="px-5 py-3 border border-[#1d1d1b] text-[#1d1d1b] text-sm tracking-wide uppercase rounded-[2.88px] hover:bg-[#cdc6be] transition-all flex items-center gap-2"
          >
            <span>Live Vercel Site</span>
            <span class="text-xs">↗</span>
          </a>
          <a 
            href="https://github.com/pratyushgupta117" 
            target="_blank" 
            rel="noopener noreferrer"
            class="px-4 py-3 text-sm text-[#1d1d1b] underline underline-offset-4 hover:text-[#c03f13] transition-colors"
          >
            GitHub Profile
          </a>
        </div>
      </div>

      <!-- Right Column: Stamp Seal Accent + Contact Card -->
      <div class="lg:col-span-5 flex flex-col items-center lg:items-end gap-6">
        
        <!-- Stamp Seal Illustration (Miranda Design Token) -->
        <div class="relative w-full max-w-[340px] bg-[#cdc6be] p-6 rounded-[11.52px] border border-[#1d1d1b] shadow-[-4px_4px_6px_0px_rgba(29,29,27,0.2)]">
          <!-- Perforated Stamp Banner top right -->
          <div class="absolute -top-3 -right-3 w-12 h-12 bg-[#c03f13] rounded-full flex items-center justify-center text-[#e2dedb] font-canopee text-xl shadow-md rotate-12">
            ★
          </div>

          <div class="border border-dashed border-[#1d1d1b] p-4 bg-[#e2dedb] rounded-[7.2px]">
            <div class="flex items-center justify-between border-b border-[#1d1d1b] pb-2 mb-3">
              <span class="micro-label text-[#1d1d1b]">SEAL OF AUTHENTICITY</span>
              <span class="text-[10px] font-editorial text-[#69645f]">REF. 2026.01</span>
            </div>

            <div class="space-y-2 font-editorial text-xs text-[#1d1d1b]">
              <div class="flex justify-between">
                <span class="text-[#69645f] micro-label">NAME</span>
                <span class="font-medium">Pratyush Gupta</span>
              </div>
              <div class="flex justify-between">
                <span class="text-[#69645f] micro-label">LOCATION</span>
                <span class="font-medium">Shahjahanpur, UP, India</span>
              </div>
              <div class="flex justify-between">
                <span class="text-[#69645f] micro-label">STATUS</span>
                <span class="font-medium text-[#c03f13]">Seeking Internship</span>
              </div>
              <div class="flex justify-between">
                <span class="text-[#69645f] micro-label">EMAIL</span>
                <a href="mailto:pratyush.epi.spn117@gmail.com" class="underline truncate max-w-[170px] hover:text-[#c03f13]">
                  pratyush.epi.spn117@gmail.com
                </a>
              </div>
              <div class="flex justify-between">
                <span class="text-[#69645f] micro-label">PHONE</span>
                <a href="tel:+919336180542" class="underline hover:text-[#c03f13]">
                  +91 93361 80542
                </a>
              </div>
            </div>

            <!-- Signature Line -->
            <div class="mt-4 pt-3 border-t border-[#1d1d1b] flex items-center justify-between">
              <span class="font-germgoth text-lg text-[#1d1d1b]">Pratyush Gupta</span>
              <span class="micro-label text-[9px] text-[#69645f]">OFFICIAL MARK</span>
            </div>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>
